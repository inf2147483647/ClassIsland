<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ClassIsland.Core.Behaviors">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!--
        华丽档的错峰入场动画。实际的隐藏态写入与逐帧插值由
        ClassIsland.Core.Assists.IntroAnimationHelper 完成（不依赖样式动画系统，
        避免“填充态清除延迟”导致的“先显示最终态再重播”抽动），
        这里只负责把 animated-intro 面板挂上行为。
    -->
    <Style Selector=":is(Panel).animated-intro">
        <Setter Property="behaviors:StackPanelIntroAnimationBehavior.IsIntroAnimationEnabled" Value="True"/>
    </Style>
</Styles>
